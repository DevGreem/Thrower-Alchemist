; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Thrower Alchemist"
run/main_scene="uid://bpfe5dk34pv1t"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameDebugger="*uid://xodsxgpsskk2"
Databases="*uid://4jbagjo2hsaa"
EventBus="*uid://b5cjin2wx7txx"
ComponentManager="*uid://dhg8bupj1ups7"
PlayerManager="*uid://dst27tilrrgpj"
TagsManager="*uid://cg7tvcqghivrn"
UIManager="*uid://dby5u3bvyp14j"
PropertiesUtilities="*uid://bx15j0x1na5xp"
ScenesManager="*uid://ca53wqrhnvgrt"

[debug]

gdscript/warnings/directory_rules={
"res://addons": 0,
"res://script_templates": 0
}
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/shadowed_global_identifier=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/int_as_enum_without_match=2
gdscript/warnings/confusable_local_declaration=2
gdscript/warnings/confusable_local_usage=2

[display]

window/size/viewport_width=256
window/size/viewport_height=144
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg", "res://addons/yard/plugin.cfg")

[global_group]

container="All Node Containers Have This"
projectiles_container=""
effects_container=""
entities_container=""
machines_container=""

[gui]

theme/custom="uid://b2nh772g2kcw"
theme/custom_font="uid://bsbkmqeodchje"

